<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_keyboard"
        android:label="@string/app_name"
        android:supportsRtl="true">

        <service
            android:name=".StealthIME"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_INPUT_METHOD"
            android:exported="true">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>

        <!-- 静态注册 + 显式广播（-n 组件名）= 兼容所有 Android 版本 -->
        <receiver
            android:name=".StealthReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.android.input.COMMIT" />
                <action android:name="com.android.input.SYNC" />
                <action android:name="com.android.input.EVENT" />
                <action android:name="com.android.input.CLEAR" />
                <action android:name="com.android.input.REPLACE" />
                <action android:name="com.android.input.EDITOR" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
